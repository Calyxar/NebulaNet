rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function isSelf(userId) {
      return signedIn() && uid() == userId;
    }

    function profileDoc(userId) {
      return get(/databases/$(database)/documents/profiles/$(userId));
    }

    function hasProfile(userId) {
      return exists(/databases/$(database)/documents/profiles/$(userId));
    }

    function isAdmin() {
      return signedIn() &&
        hasProfile(uid()) &&
        profileDoc(uid()).data.role == "admin";
    }

    function ownsCommunity(communityId) {
  return signedIn() &&
    get(
      /databases/$(database)/documents/communities/$(communityId)
    ).data.owner_id == uid();
}

    function isOfficialAccount(userId) {
      return hasProfile(userId) &&
        profileDoc(userId).data.is_official == true;
    }

    function isMinor() {
      return signedIn() &&
        hasProfile(uid()) &&
        (profileDoc(uid()).data.age_group == "teen" ||
         profileDoc(uid()).data.age_group == "under_13");
    }

    function isCounterUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['like_count', 'comment_count', 'repost_count', 'save_count', 'share_count', 'view_count']);
    }

    function isPollVoteUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['poll', 'updated_at', 'updated_at_ts']);
    }

    function isSelfProfileUpdate(userId) {
      return isSelf(userId) &&
        resource.data.is_suspended != true &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['is_official', 'role']);
    }

    function isValidBirthdayFields(data) {
  return (!('age_group' in data) || data.age_group in ['under_13', 'teen', 'adult']) &&
    (!('birthMMDD' in data) || data.birthMMDD.matches('^(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')) &&
    (!('showBirthday' in data) || data.showBirthday is bool) &&
    (!('birthDate' in data) || data.birthDate is timestamp);
}

  function isNotAgeDowngrade() {
  return !(resource.data.age_group == 'adult' &&
    request.resource.data.age_group in ['teen', 'under_13']);
}

   match /profiles/{userId} {
  allow read, get, list: if signedIn();
  allow create: if isSelf(userId) && isValidBirthdayFields(request.resource.data);
  allow update: if isAdmin() ||
    (isSelfProfileUpdate(userId) &&
     isValidBirthdayFields(request.resource.data) &&
     isNotAgeDowngrade());
  allow delete: if isSelf(userId) || isAdmin();
}
    match /follows/{followId} {
      allow read, get, list: if signedIn();
      allow create: if signedIn() && request.resource.data.follower_id == uid();
      allow update: if signedIn() && resource.data.follower_id == uid();
      allow delete: if signedIn() && resource.data.follower_id == uid();
    }

    match /notifications/{notifId} {
      allow read: if signedIn() && resource.data.receiver_id == uid();
      allow create: if signedIn();
      allow update: if signedIn() && resource.data.receiver_id == uid();
      allow delete: if signedIn() && resource.data.receiver_id == uid();
    }

    match /posts/{postId} {
      allow read, get, list: if signedIn() &&
        (resource.data.is_nsfw != true || !isMinor());
      allow create: if signedIn();
      allow update: if signedIn() && (
  (
    resource.data.user_id == uid() &&
    !request.resource.data.diff(resource.data).affectedKeys()
      .hasAny([
        "is_boosted",
        "boosted_until",
        "boosted_at"
      ])
  ) ||
  isAdmin() ||
  isCounterUpdate() ||
  isPollVoteUpdate()
);
      allow delete: if signedIn() && (resource.data.user_id == uid() || isAdmin());

      match /poll_votes/{voteId} {
        allow create: if signedIn() &&
  request.resource.data.user_id == uid() &&

  request.resource.data.like_count == 0 &&
  request.resource.data.comment_count == 0 &&
  request.resource.data.repost_count == 0 &&
  request.resource.data.share_count == 0 &&
  request.resource.data.save_count == 0 &&
  request.resource.data.view_count == 0 &&

  request.resource.data.is_boosted == false &&

  (
    !("boosted_until" in request.resource.data) ||
    request.resource.data.boosted_until == null
  ) &&

  (
    !("boosted_at" in request.resource.data) ||
    request.resource.data.boosted_at == null
  );
        allow create: if signedIn() && voteId == uid();
        allow update: if false;
        allow delete: if false;
      }
    }

    match /likes/{likeId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.user_id == uid();
      allow delete: if signedIn() && resource.data.user_id == uid();
    }

    match /author_affinity/{affinityId} {
      allow read: if signedIn() && resource.data.viewer_id == uid();
      allow create, update: if signedIn() && request.resource.data.viewer_id == uid();
      allow delete: if false;
    }

    match /saves/{saveId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.user_id == uid();
      allow delete: if signedIn() && resource.data.user_id == uid();
    }

    match /hidden_posts/{hiddenId} {
      allow read: if signedIn() && resource.data.user_id == uid();
      allow create: if signedIn() && request.resource.data.user_id == uid();
      allow delete: if signedIn() && resource.data.user_id == uid();
    }

    match /comments/{commentId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if signedIn() && (resource.data.user_id == uid() || isCounterUpdate());
      allow delete: if signedIn() && (resource.data.user_id == uid() || isAdmin());
    }

    match /comment_likes/{likeId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.user_id == uid();
      allow delete: if signedIn() && resource.data.user_id == uid();
    }

    match /reposts/{repostId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.user_id == uid();
      allow delete: if signedIn() && resource.data.user_id == uid();
    }

    match /communities/{communityId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.owner_id == uid();
      allow update: if signedIn() && (resource.data.owner_id == uid() || isAdmin());
      allow delete: if signedIn() && (resource.data.owner_id == uid() || isAdmin());
    }

    match /community_members/{memberId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.user_id == uid();
      allow delete: if signedIn() && resource.data.user_id == uid();
    }

    match /community_moderators/{modId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.user_id == uid();
      allow delete: if signedIn() && resource.data.user_id == uid();
    }

    match /community_rules/{ruleId} {
  allow read: if signedIn();

  allow create: if
    ownsCommunity(request.resource.data.community_id);

  allow update: if
    ownsCommunity(resource.data.community_id);

  allow delete: if
    ownsCommunity(resource.data.community_id);
}

    match /user_settings/{userId} {
      allow read: if isSelf(userId);
      allow write: if isSelf(userId);
    }

    match /user_interests/{userId} {
      allow read: if signedIn();
      allow write: if isSelf(userId);
    }
    match /stories/{storyId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if signedIn() && resource.data.user_id == uid();
      allow delete: if signedIn() && (resource.data.user_id == uid() || isAdmin());
    }

    match /story_views/{viewId} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    match /story_seen/{seenId} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    match /story_comments/{commentId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if signedIn() && resource.data.user_id == uid();
      allow delete: if signedIn() && (resource.data.user_id == uid() || isAdmin());
    }

    match /conversations/{convoId} {
      allow get: if signedIn() && uid() in resource.data.participant_ids;
      allow list: if signedIn();
      allow create: if signedIn() && uid() in request.resource.data.participant_ids;
      allow update: if signedIn() && uid() in resource.data.participant_ids;
      allow delete: if signedIn() && uid() in resource.data.participant_ids;

      match /messages/{messageId} {
        allow read: if signedIn() &&
          uid() in get(/databases/$(database)/documents/conversations/$(convoId)).data.participant_ids;
        allow create: if signedIn() &&
          uid() in get(/databases/$(database)/documents/conversations/$(convoId)).data.participant_ids &&
          request.resource.data.sender_id == uid();
        allow update: if signedIn() && resource.data.sender_id == uid();
        allow delete: if signedIn() && resource.data.sender_id == uid();
      }

      match /participants/{participantId} {
        allow read: if signedIn() &&
          uid() in get(/databases/$(database)/documents/conversations/$(convoId)).data.participant_ids;
        allow create: if signedIn();
        allow update: if signedIn() && (
          participantId == uid() ||
          uid() in get(/databases/$(database)/documents/conversations/$(convoId)).data.participant_ids
        );
        allow delete: if signedIn() && participantId == uid();
      }

      match /typing/{typingUserId} {
        allow read: if signedIn() &&
          uid() in get(/databases/$(database)/documents/conversations/$(convoId)).data.participant_ids;
        allow write: if signedIn() && typingUserId == uid();
      }
    }

    match /conversation_participants/{participantId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if signedIn() && resource.data.user_id == uid();
      allow delete: if signedIn() && resource.data.user_id == uid();
    }

    match /messages/{messageId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.sender_id == uid();
      allow update: if signedIn() && resource.data.sender_id == uid();
      allow delete: if signedIn() && resource.data.sender_id == uid();
    }

    match /boosts/{boostId} {
      allow create: if signedIn()
        && request.resource.data.user_id == uid()
        && request.resource.data.status == "active";
      allow read: if signedIn() && (resource.data.user_id == uid() || isAdmin());
      allow update, delete: if false;
    }

    match /used_boost_transactions/{transactionId} {
      allow read, write: if false;
    }

    match /account_deletion_requests/{userId} {
      allow read: if isSelf(userId);
      allow write: if isSelf(userId);
    }

    match /data_export_requests/{userId} {
      allow read: if isSelf(userId);
      allow write: if isSelf(userId);
    }

    match /blocks/{blockId} {
      allow read: if signedIn() && (resource.data.blocker_id == uid() || resource.data.blocked_id == uid());
      allow create: if signedIn() && request.resource.data.blocker_id == uid();
      allow delete: if signedIn() && resource.data.blocker_id == uid();
    }

    match /user_blocks/{blockId} {
      allow read: if signedIn() && (resource.data.blocker_id == uid() || resource.data.blocked_id == uid());
      allow create: if signedIn() && request.resource.data.blocker_id == uid();
      allow delete: if signedIn() && resource.data.blocker_id == uid();
    }

    match /polls/{pollId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if signedIn();

      match /votes/{voteId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.user_id == uid();
        allow update: if signedIn() && resource.data.user_id == uid();
        allow delete: if signedIn() && resource.data.user_id == uid();
      }
    }

    match /events/{eventId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if signedIn() && (resource.data.creator_id == uid() || isAdmin());
      allow delete: if signedIn() && (resource.data.creator_id == uid() || isAdmin());
    }

    match /hashtags/{hashtagId} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /hashtag_counts/{hashtagId} {
      allow read: if true;
      allow write: if signedIn();
    }

       match /support_reports/{reportId} {
  allow create: if signedIn() && request.resource.data.user_id == uid();
  allow read: if signedIn() && (resource.data.user_id == uid() || isAdmin());
}

match /reports/{reportId} {
  allow create: if signedIn() &&
    request.resource.data.reporter_id == uid();

  allow read: if signedIn() &&
    (
      resource.data.reporter_id == uid() ||
      isAdmin()
    );

  allow update, delete: if isAdmin();
}

    match /post_views/{viewId} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    match /post_views/{viewId} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    // ✅ ADDED: Cloud Function writes here; client reads only own doc
    match /parental_verifications/{userId} {
      allow read: if isSelf(userId);
      allow write: if false; // Cloud Function only (admin SDK)
    }

    // ✅ FIXED: was missing entirely — lib/firestore/presence.ts reads
    // and listens to this collection to respect the user's
    // activity_status privacy toggle. With no explicit match block, the
    // catch-all deny rule was silently blocking it, surfacing as
    // "presence: privacy settings onSnapshot error" with a generic
    // permission-denied error rather than any indication the rule was
    // simply missing.
    match /user_privacy_settings/{userId} {
      allow read: if isSelf(userId);
      allow write: if isSelf(userId);
    }

    match /app_config/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ✅ FIXED: was missing entirely — AnnouncementCard.tsx queries this
    // collection, but with no explicit match block here, the catch-all
    // deny rule at the bottom of this file was silently blocking every
    // read, surfacing as a generic permission-denied error with no
    // indication that the real problem was a missing rule, not a bug
    // in the query itself.
    match /announcements/{announcementId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // News tab — synced server-side by the syncNewsFromCurrents Cloud
    // Function (Admin SDK, bypasses these rules entirely). Client only reads.
    match /news_articles/{articleId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /news_meta/{category} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /muted_users/{muteId} {
      allow read: if signedIn() && resource.data.muter_id == uid();
      allow create: if signedIn() && request.resource.data.muter_id == uid();
      allow delete: if signedIn() && resource.data.muter_id == uid();
    }

    match /user_preferences/{userId} {
      allow read: if isSelf(userId);
      allow write: if isSelf(userId);
    }

    match /linked_accounts/{accountId} {
      allow read: if signedIn() && resource.data.user_id == uid();
      allow create: if signedIn() && request.resource.data.user_id == uid();
      allow delete: if signedIn() && resource.data.user_id == uid();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
